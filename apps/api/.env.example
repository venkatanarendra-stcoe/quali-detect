# Placeholders only. Copy to .env (loaded by `pnpm dev`); never commit real secrets. Only variables with a security meaning
# that is easy to miss are listed here; every variable and its default is documented in src/config/index.js.

# HMAC signing key of pagination cursors. Comma-separated, NEWEST FIRST: the first secret signs, all of them verify.
# Each secret needs 32 to 256 characters (for example `openssl rand -hex 32`). The raw value is never used as a key: a
# subkey is derived with HKDF over a fixed label. Required in production. In development and test, leaving it unset
# generates a random secret per process (cursors stop working when the API restarts; clients restart their walk).
# Rotation: put the new secret first, keep the old one until cursors signed with it have expired in practice, then remove it.
# A cursor signed with a key that is no longer listed is refused with 400 INVALID_CURSOR.
# CURSOR_SIGNING_SECRET=<64 random hex characters>

# Realtime (Socket.IO hints), docs/modules/executions/SPEC.md section 17.ad. OFF by default. SINGLE INSTANCE ONLY: there is no
# Redis adapter, so the sockets and the `realtime` queue consumer both live in this API process; run one API instance while it
# is on (a hint consumed by another instance never reaches these sockets; the UI falls back to polling, correctness never depends
# on the socket). The socket is authenticated by the tenant SESSION COOKIE only (no token in the URL or the auth payload), the
# Origin must be one of CORS_ALLOWED_ORIGINS, and the path is /api/v1/socket.io (below the cookie path). WebSocket transport only.
# REALTIME_ENABLED=false
# REALTIME_MAX_ROOMS_PER_SOCKET=20         subscriptions per socket
# REALTIME_MAX_DENIED_JOINS=5              denied joins within the window that disconnect the socket and block its session
# REALTIME_DENIED_WINDOW_SECONDS=60        window of the denial counter and length of the session penalty
# REALTIME_REAUTH_SECONDS=60               every socket is re-validated this often (session, tenant, membership, permissions)
# REALTIME_MAX_CONNECTIONS_PER_IP=20       concurrent connections per client address
# REALTIME_MAX_CONNECTIONS_PER_SESSION=5   concurrent connections per session
# REALTIME_CONNECT_RATE_PER_MINUTE=60      handshakes per client address per minute
# REALTIME_JOIN_RATE_PER_MINUTE=60         subscribe events per socket per minute
# REALTIME_EVENTS_PER_MINUTE=240           all inbound events per socket per minute (a flood disconnects)
# REALTIME_MAX_PAYLOAD_BYTES=2048          largest client message (the connection is closed above it)

# Optional LLM assistant (docs/decisions/ADR-013, docs/modules/scan-decisioning/SPEC.md). OFF by default: with LLM_PROVIDER=none
# (or unset) the product works exactly as before and the Settings > AI page shows the assistant as not configured. The API reads
# these only to tell the tenant which kind of provider is configured (local or external); it never calls a model and never needs a
# key. There is NO default model: LLM_MODEL is required when LLM_PROVIDER is not none. Base URLs are deployment settings and are
# never tenant-supplied; the hosted ones must be https in production. API keys are NEVER set here or stored in the database: they
# are platform secrets (llm.anthropic.api_key, llm.openai.api_key) read by the process that calls the provider, in development
# from LLM_ANTHROPIC_API_KEY / LLM_OPENAI_API_KEY (or the same name with a _FILE suffix pointing to a file).
# An external provider (anthropic, openai) is used for a tenant only after that tenant turns on the audited consent setting.
# LLM_PROVIDER=none                       none | ollama (local, no consent needed) | anthropic | openai (external, consent needed)
# LLM_MODEL=
# LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# LLM_OPENAI_BASE_URL=https://api.openai.com
# LLM_REQUEST_TIMEOUT_SECONDS=30          hard timeout of one provider request (1 to 300)
# LLM_MAX_CONCURRENT_CALLS=4              per-process cap on simultaneous provider calls (1 to 64)

# Reporting and dashboards (docs/modules/reporting-dashboards/SPEC.md; OFF by default: nothing is read, queued or written for it while false).
# REPORTING_RO_DATABASE_URL is the connection string of the restricted LOGIN role that is a member of qm_reporting_ro (select on the report
# views only, read-only transactions, 5 s statement timeout). It is a SECRET (never logged), REQUIRED in production while the module is on, and
# optional in development (the shared pool is used, with a warning). Provision it with: pnpm --filter @qmentisai/db provision:reporting-logins
REPORTING_ENABLED=false
# REPORTING_RO_DATABASE_URL=
# REPORTING_EXPORT_RETENTION_DAYS=30   generated report files are deleted after this many days (1 to 365)
