{
  "name": "@qmentisai/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express 5 API (modular monolith)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check:connections": "node --env-file-if-exists=.env scripts/check-connections.js",
    "test:security": "node scripts/security-suite.js",
    "contract:snapshot": "node scripts/snapshot-contract.js",
    "contract:parity": "node scripts/contract-parity.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@qmentisai/contracts": "workspace:*",
    "@qmentisai/db": "workspace:*",
    "@qmentisai/infra": "workspace:*",
    "@qmentisai/shared": "workspace:*",
    "cookie-parser": "catalog:",
    "cors": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "rate-limit-redis": "catalog:",
    "swagger-ui-express": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@qmentisai/config": "workspace:*",
    "eslint": "catalog:"
  }
}
