# Placeholders only. Vite exposes only variables prefixed with VITE_.
# API base path used by the browser (default /api/v1, proxied to the API in development).
VITE_API_BASE_URL=/api/v1
# Development proxy target for /api (the API origin). Not used in production builds.
VITE_DEV_API_TARGET=http://localhost:3000
# Shown in the environment strip: development | staging | production
VITE_ENVIRONMENT=development
