# Placeholders only. Copy to .env (loaded by `pnpm start:<worker>` / `pnpm dev:<worker>`); never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info
# Required by every worker. Must be valid URLs.
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://USER:PASSWORD@localhost:5672
# Optional until handlers use the database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/qmentisai
# Consumer tuning (defaults shown)
WORKER_PREFETCH=5
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_DELAY_MS=1000
WORKER_RETRY_MAX_DELAY_MS=60000
WORKER_IDEMPOTENCY_TTL_SECONDS=86400
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Pipeline schedules (scheduler worker; defaults shown, SPEC pipelines-triggers §6.4)
PIPELINE_SCHEDULE_TICK_SECONDS=60
PIPELINE_SCHEDULE_BATCH=100
PIPELINE_SCHEDULE_MAX_PER_TENANT_PER_TICK=10
PIPELINE_SCHEDULE_MAX_LATENESS_SECONDS=21600
PIPELINE_SCHEDULE_ON_TIME_GRACE_SECONDS=120
PIPELINE_SCHEDULE_JITTER_SECONDS=300
# Execution orchestrator (docs/modules/executions/SPEC.md part C). OFF by default: with the flag off the `pipeline` queue keeps its
# no-op handler and the `scan` worker stays a no-op. The pipeline worker (with the GitHub App settings and platform secrets,
# GITHUB_APP_ENABLED=true) claims, prepares and drives executions; the scan worker needs NO GitHub or SecretStore settings (ER-5)
# but both workers need the same ARTIFACT_STORE_ROOT (a local directory shared by the two processes; single host only, EQ-4).
# The orchestrator claims an execution only if an engine is registered for every scan type it enables (none ships yet).
EXECUTION_ORCHESTRATOR_ENABLED=false
# TEST-ONLY (live test): hold every task for N ms before its engine starts, to open a window for running-cancel, timeout and
# lease reclaim. Refused when NODE_ENV=production. Leave unset.
# EXECUTION_TEST_DELAY_MS=20000
# ARTIFACT_STORE_ROOT=/var/lib/qmentisai/artifacts
# Lease and heartbeat (TTL must be greater than 3 x heartbeat), defaults shown
EXECUTION_HEARTBEAT_SECONDS=10
EXECUTION_LEASE_TTL_SECONDS=60
# Queue age after which a queued row is never started (ER-9/ER-31/ER-32; the one-time first-enable sweep cancels older rows as expired_stale)
EXECUTION_STALE_QUEUE_THRESHOLD_SECONDS=86400
EXECUTION_SWEEP_INTERVAL_SECONDS=15
EXECUTION_SWEEP_MAX_PER_TENANT_PER_TICK=5
EXECUTION_SWEEP_BATCH_SIZE=50
EXECUTION_TASK_PARALLELISM=2
EXECUTION_TASK_MAX_ATTEMPTS=2
EXECUTION_MAX_RECLAIMS=2
EXECUTION_PREPARE_MAX_ATTEMPTS=3
EXECUTION_PREPARE_RETRY_DELAY_MS=1000
EXECUTION_MAX_RESULT_ITEMS_PER_TASK=50000
# Archive caps (hard limits fail the execution with prepare_failed:archive_too_large)
EXECUTION_ARCHIVE_MAX_BYTES=209715200
EXECUTION_ARCHIVE_MAX_ENTRIES=100000
EXECUTION_ARCHIVE_MAX_FILE_BYTES=52428800
EXECUTION_ARCHIVE_MAX_EXPANDED_BYTES=1073741824
EXECUTION_ARCHIVE_MAX_RATIO=200
EXECUTION_ARCHIVE_MAX_DEPTH=64

# Optional LLM assistant (docs/decisions/ADR-013). Same variables as apps/api/.env.example (set the same values in both files: the
# API only uses them to tell the UI whether an assistant exists and of which kind); the pipeline worker calls the provider from the
# scan-decisioning agent. OFF by default
# (LLM_PROVIDER=none). No default model. Keys are platform secrets (LLM_ANTHROPIC_API_KEY / LLM_OPENAI_API_KEY, or the _FILE
# variant), never in the database, never logged. An external provider is used for a tenant only with that tenant's audited consent.
# LLM_PROVIDER=none
# LLM_MODEL=
# LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# LLM_OPENAI_BASE_URL=https://api.openai.com
# LLM_REQUEST_TIMEOUT_SECONDS=30
# LLM_MAX_CONCURRENT_CALLS=4
# The pipeline worker reads and validates these at startup (config.llm). The scan worker reads none of them. Production refuses the environment secret provider, so a hosted
# provider cannot be used in production until a KMS/Vault provider exists; a local Ollama needs no key.

# Scan decisioning, change detection and the deterministic floor (docs/modules/scan-decisioning/SPEC.md 5.2, 5.3, 17.c, 17.e):
# the orchestrator runs the decision inside the preparing state (no flag of its own). The bounds stay at or below the documented GitHub limits (compare lists at most 300 files,
# pull-request files at most 3000 in 30 pages of 100); over a bound the floor becomes ALL enabled types (fail closed).
# Secrets rule: any_change is the only rule (a file added, modified or renamed, of any class; a pure deletion never triggers a scan). Any other value stops the worker at start.
# SCAN_DECISION_SECRETS_RULE=any_change
# SCAN_DECISION_MAX_CHANGED_FILES=3000
# SCAN_DECISION_MAX_PAGES=30
# SCAN_DECISION_SAMPLE_PATHS=20

# Scan decision agent (SPEC scan-decisioning 5.4, 17.d). The overall timeout must stay below
# EXECUTION_LEASE_TTL_SECONDS (the agent runs under the lease); turns at most 5; the number of changed-file paths sent as data.
# SCAN_DECISION_AGENT_TIMEOUT_SECONDS=20
# SCAN_DECISION_MAX_TURNS=3
# SCAN_DECISION_CONTEXT_PATHS=100

# Scan engines (docs/modules/scan-engines/SPEC.md parts A and K). OFF by default (D-12). While "true" the scan worker registers the ensemble
# SBOM engine (Syft + Trivy in sandboxes + the built-in inventory) under sbom/default and starts the janitor of orphan containers, and the
# decision step of an incremental execution stores the changed-path artifact. The two paths below are then REQUIRED (absolute, not under
# /etc, /home, /var/run ...): the directory where the scan worker extracts trees (mounted read-only into every tool container) and the
# platform tool configuration (copy the WHOLE rules directory of the SBOM ensemble there: syft.yaml, trivy.yaml, osv-scanner.toml and canary.cdx.json).
# Since part G the same flag also registers the ensemble SCA engine (Trivy language ecosystems only + OSV-Scanner offline) under sca/default; it
# needs the verified vulnerability snapshots: SCAN_DB_MIRROR_ROOT and SCAN_DB_CACHE_ROOT below (without both, every SCA tool is unavailable).
SCAN_ENGINES_ENSEMBLE_ENABLED=false
# SANDBOX_ARCHIVE_ROOT=/var/lib/qm/scan
# SANDBOX_RULES_DIR=/var/lib/qm/rules
# SCAN_ENGINE_TOOL_PARALLELISM=2
# SCAN_RUNNER_MAX_CONTAINERS=4
# SCAN_RUNNER_MAX_CONTAINERS_PER_TENANT=2
# SCAN_UNTRUSTED_CAPACITY_SHARE=50
# SCAN_RUNNER_WAIT_SECONDS=120
# SCAN_RUNNER_JANITOR_SECONDS=60
# Docker-compatible CLI used through execFile (docker | podman). Rootless operation and uid mapping are UNVERIFIED (ENG-L18).
SANDBOX_RUNTIME_BIN=podman
SANDBOX_USER=65534:65534
# SANDBOX_USERNS_MODE=keep-id
# SANDBOX_UIDMAP=
# SANDBOX_GIDMAP=
# SANDBOX_SECCOMP_PROFILE=/absolute/path/to/seccomp.json

# Vulnerability DB mirror (docs/modules/scan-engines/SPEC.md 5.12 and 17.p, part F). OFF by default: nothing is scheduled or handled
# while false. Enabling it also needs a downloader wired into the `dbrefresh` worker (not built yet: the job fails closed without one).
# The two directories are REQUIRED then (absolute and different): the content-addressed mirror and the host cache the sandbox mounts
# read-only at /db (the sandbox mount roots of the dbrefresh and scan workers must include the cache). No URL or credential belongs here.
# The scan worker reads the same two roots (SCA engine); the dbrefresh worker also needs SANDBOX_RULES_DIR (the canary scan reads its platform file from it).
SCAN_DB_REFRESH_ENABLED=false
# SCAN_DB_MIRROR_ROOT=/var/lib/qm/dbmirror
# SCAN_DB_CACHE_ROOT=/var/lib/qm/db
# SCAN_DB_REFRESH_TOOLS=trivy,osv-scanner
# SCAN_DB_REFRESH_INTERVAL_SECONDS=21600
# SCAN_DB_MAX_BYTES=4294967296
# SCAN_DB_MIN_SIZE_PERCENT=50
# SCAN_DB_MAX_UPSTREAM_AGE_DAYS=30
# SCAN_DB_KEEP_RETIRED=3
# SCAN_DB_CANDIDATE_ABANDON_SECONDS=3600
# SCAN_DB_LOCK_TTL_SECONDS=3600
# Staleness tiers by the upstream build time: fresh up to 3 days, aging over 3, stale over 14, expired over 30. Never fails a scan.
# SCAN_DB_STALE_AGING_DAYS=3
# SCAN_DB_STALE_STALE_DAYS=14
# SCAN_DB_STALE_EXPIRED_DAYS=30

# Findings (docs/modules/findings/SPEC.md; both flags OFF by default: nothing is ingested, queued or advised while false).
# FINDINGS_INGESTION_ENABLED hosts the `findings` worker (ingestion, expiry, SLA, retention) and writes the second outbox row of IN-1.
# FINDINGS_AGENT_ENABLED hosts the `findings-agent` worker (advisory only). Its FINDINGS_AGENT_DATABASE_URL is the connection string of
# the restricted LOGIN role that is a member of qm_fp_agent (read view + advisory insert only). It is a SECRET (never logged) and REQUIRED
# in production while the agent is enabled. Provision it with: pnpm --filter @qmentisai/db provision:fp-agent-login
FINDINGS_INGESTION_ENABLED=false
FINDINGS_AGENT_ENABLED=false
# FINDINGS_AGENT_DATABASE_URL=
# FINDINGS_FIX_CONFIRMATIONS=1
# FINDINGS_AGENT_MAX_CONCURRENT_CALLS=2
# FINDINGS_AGENT_TENANT_DAILY_CAP=500
