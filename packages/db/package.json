{
  "name": "@qmentisai/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema and client",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "seed:findings": "node --env-file-if-exists=.env prisma/seed-findings.js",
    "db:format": "prisma format",
    "provision:fp-agent-login": "node --env-file-if-exists=.env scripts/provision-fp-agent-login.js"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "@qmentisai/shared": "workspace:*"
  },
  "devDependencies": {
    "@qmentisai/config": "workspace:*",
    "eslint": "catalog:",
    "prisma": "catalog:"
  }
}
