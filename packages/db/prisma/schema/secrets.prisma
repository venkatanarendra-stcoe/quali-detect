// ---------------------------------------------------------------- Secret storage foundation (ADR-009)
// Plaintext is never stored. Every row carries tenantId and is read only with it (see packages/db/src/secret-repository.js).

enum DataKeyStatus {
  active
  retiring
  retired

  @@map("data_key_status")
}

/// A tenant's data-encryption key (DEK), stored ONLY wrapped by the master key (AES-256-GCM). `masterKeyVersion` records
/// which master key wrapped it, `version` is the DEK version stored with every secret encrypted under it.
model TenantDataKey {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  version          Int
  /// base64(nonce | ciphertext | tag)
  wrappedKey       String        @map("wrapped_key")
  masterKeyVersion Int           @map("master_key_version")
  status           DataKeyStatus @default(active)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, version])
  @@index([tenantId, status])
  @@map("tenant_data_keys")
}

/// An encrypted credential. `id` is the opaque `secretRef` handed to other components. `purpose` and `dekVersion` are part of
/// the AES-GCM additional authenticated data together with tenantId and id, so a ciphertext cannot be replayed elsewhere.
model Secret {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  purpose    String
  /// base64(ciphertext | tag); empty once deleted
  ciphertext String
  /// base64, 12 random bytes per encryption
  nonce      String
  dekVersion Int       @map("dek_version")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt  DateTime? @map("rotated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, purpose])
  @@map("secrets")
}
